{
  "name": "Yomi Reader",
  "short_name": "Yomi",
  "description": "A quiet home for your light novels.",
  "start_url": "/#library",
  "scope": "/",
  "display": "standalone",
  "background_color": "#171c26",
  "theme_color": "#171c26",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
