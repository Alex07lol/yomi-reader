# Yomi Reader — public frontend configuration.
#
# Copy this file to `.env.local` for local development.
# In Cloudflare Pages, set the same names under
# Settings → Environment variables for the chosen environment.
#
# These two values are public: they are embedded in the browser bundle and
# are protected by Row Level Security. NEVER put a service-role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: which social sign-in buttons to show (comma-separated).
# Supported: google, github. When this line is absent/left commented out, both
# are offered. Set it to an empty value (VITE_SUPABASE_OAUTH_PROVIDERS=) to hide
# the "continue with" row. Each provider must also be enabled in the Supabase
# dashboard (Authentication → Providers).
# VITE_SUPABASE_OAUTH_PROVIDERS=google,github
